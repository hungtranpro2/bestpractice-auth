# Browser-to-NestJS URL.
# Local development: use localhost for both apps; cookie host scope ignores ports.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/v1

# Server Components call NestJS over the private network, not through the browser.
API_INTERNAL_URL=http://localhost:4000/v1

# Must match the NestJS SESSION_COOKIE_NAME exactly.
SESSION_COOKIE_NAME=__Host-session

# Production behind the same-host reverse proxy:
# NEXT_PUBLIC_API_BASE_URL=/v1
# API_INTERNAL_URL=http://api:4000/v1
