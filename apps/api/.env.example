NODE_ENV=development
PORT=4000

# Local PostgreSQL from the repository docker-compose.yml
DATABASE_URL=postgresql://auth:auth_dev_only@localhost:5432/bestpractice_auth?schema=public

# Comma-separated exact browser origins. Never use * with credentialed CORS.
WEB_ORIGINS=http://localhost:3000

# __Host- cookies require Secure, Path=/ and no Domain.
# For local development use http://localhost (not 127.0.0.1).
SESSION_COOKIE_NAME=__Host-session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_DAYS=7
SESSION_IDLE_TTL_MINUTES=1440

# Generate with: openssl rand -hex 32
CSRF_SECRET=replace-with-at-least-32-random-bytes-before-running

# Set only when behind a known reverse proxy; trust exactly the configured hop count.
TRUST_PROXY_HOPS=0